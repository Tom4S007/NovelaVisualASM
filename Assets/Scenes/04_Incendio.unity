    personaje: 1
    nombreVisible: 
    texto: "\xBFCon quien deberia hablar antes de empezar el dia?"
    expresion: {fileID: 0}
    siguienteLinea: 
    fondo: {fileID: 0}
    sonido: {fileID: 0}
    ambiente: {fileID: 0}
    glitch: 0
    tieneOpciones: 1
