    nombreVisible: 
    texto: 
    expresion: {fileID: 0}
    siguienteLinea: c2_26
    fondo: {fileID: 0}
    sonido: {fileID: 0}
    ambiente: {fileID: 0}
    glitch: 0
    tieneOpciones: 0
