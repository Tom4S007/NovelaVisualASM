    siguienteSiCumple: 
    esCapsula: 0
    palabrasAElegir: 0
    palabras: []
  - id: c2_03
    personaje: 0
    nombreVisible: 
    texto: "Sebas te dice que hay un olor raro en la ladera. Tu confianza con \xE9l
      aumenta +1"
    expresion: {fileID: 0}
    siguienteLinea: c2_06
    fondo: {fileID: 0}
    sonido: {fileID: 0}
    ambiente: {fileID: 0}
    glitch: 0
    tieneOpciones: 0
    opciones: []
    esSalto: 0
    condicion: 0
    invertir: 0
    siguienteSiCumple: 
    esCapsula: 0
    palabrasAElegir: 0
    palabras: []
  - id: c2_04
    personaje: 0
    nombreVisible: 
    texto: 'Camila te expresa su preocupacion por lo que la sequia podria provocar,
      tu confianza con ella ha aumentado '
    expresion: {fileID: 0}
    siguienteLinea: c2_06
    fondo: {fileID: 0}
    sonido: {fileID: 0}
    ambiente: {fileID: 0}
    glitch: 0
