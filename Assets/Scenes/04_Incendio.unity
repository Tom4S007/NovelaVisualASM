    esSalto: 0
    condicion: 0
    invertir: 0
    siguienteSiCumple: 
    esCapsula: 1
    palabrasAElegir: 3
    palabras:
    - texto: "Llamen a emergencias y reporten d\xF3nde ven el fuego; no se acerquen"
      correcta: 1
      leGustaA: 6
      reaccion: 
    - texto: Suban con baldes y ramas a ayudar a apagarlo
      correcta: 0
      leGustaA: 6
      reaccion: 
    - texto: "Qu\xE9dense en casa, cierren todo y cuiden a ni\xF1os y mayores"
      correcta: 1
      leGustaA: 6
      reaccion: 
    - texto: Si ordenan evacuar, salgan con agua, documentos y medicinas hacia el
        punto de encuentro
      correcta: 1
      leGustaA: 6
      reaccion: 
    - texto: Graben el fuego de cerca para subirlo a redes
      correcta: 0
      leGustaA: 6
      reaccion: 
  - id: c2_26
    personaje: 0
    nombreVisible: 
