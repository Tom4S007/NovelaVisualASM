    esCapsula: 0
    palabrasAElegir: 0
    palabras: []
  - id: c2_05
    personaje: 0
    nombreVisible: 
    texto: Chela te cuenta de los chismes y rumores del barrio, tu confianza con
      ella ha aumentado
    expresion: {fileID: 0}
    siguienteLinea: c2_06
    fondo: {fileID: 0}
    sonido: {fileID: 0}
    ambiente: {fileID: 0}
    glitch: 0
